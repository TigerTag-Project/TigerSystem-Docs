# Copy to .env for local work. Never commit the real values.

# scripts/translate.mjs — refreshes i18n/fr/ from docs/.
# Only needed when regenerating translations; the site builds without it.
ANTHROPIC_API_KEY=

# Optional overrides for the translator.
# TRANSLATE_MODEL=claude-opus-5
# TRANSLATE_EFFORT=low
# TRANSLATE_CONCURRENCY=4

# Giscus (comments). Read the category id from https://giscus.app after
# enabling Discussions on the repository. Set these in the Vercel project too.
PUBLIC_GISCUS_CATEGORY_ID=
# PUBLIC_GISCUS_CATEGORY=Docs
# PUBLIC_GISCUS_REPO=TigerTag-Project/TigerSystem-Docs
# PUBLIC_GISCUS_REPO_ID=R_kgDOTdiZjQ
