---
/**
 * Header brand: the app icon plus the wordmark.
 *
 * `tigersystem-app-icon.svg` is the square app icon — it carries its own dark
 * ground, so one file serves both themes; the corners are rounded in CSS
 * rather than by shipping a second, pre-rounded file.
 */
const locale = Astro.currentLocale;
const href = locale && locale !== 'en' ? `/${locale}/` : '/';
---

<a class="site-title" href={href}>
  <img class="site-title__mark" src="/assets/logos/tigersystem-app-icon.svg" alt="" width="32" height="32" />
  <span class="site-title__text">
    <span class="site-title__name">TigerSystem</span>
    <span class="site-title__kind">Wiki</span>
  </span>
</a>
